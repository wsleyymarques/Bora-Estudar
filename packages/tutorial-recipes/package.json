{
  "name": "@bora-estudar/tutorial-recipes",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./recipes/*": "./recipes/*.yaml"
  },
  "scripts": {
    "build": "tsc && cp -r recipes dist/ 2>/dev/null || true",
